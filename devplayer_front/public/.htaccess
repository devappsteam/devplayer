<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Se a requisição é para um arquivo ou diretório existente, serve normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Caso contrário, redireciona para index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  # Bloquear envio de Referer em requisições
  Header set Referrer-Policy "no-referrer"
  
  # Adicionar headers para cacheamento correto
  # Cache para arquivos com hash (nunca mudam)
  <FilesMatch "\-[a-f0-9]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Cache para assets normais
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  
  # Sem cache para index.html
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  
  # Adicionar MIME type correto para JS
  AddType application/javascript js
</IfModule>

